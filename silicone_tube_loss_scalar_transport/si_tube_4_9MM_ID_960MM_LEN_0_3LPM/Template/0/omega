FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      omega;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 -1 0 0 0 0];

internalField   uniform 73.1;

boundaryField
{
    axis
    {
        type            symmetryPlane;
    }

    inlet           
    {
        type            fixedValue;
        value           $internalField;
    }

    outlet          
    {
        type            zeroGradient;
    }

    upperWall
    {
        type            omegaWallFunction;
        value           uniform 1;
    }

    back
    {
        type            wedge;
    }
    front
    {
        type            wedge;
    }
}


